{
  "type": "payment",
  "code": "epay_v1",
  "version": "0.4.0",
  "abi_version": 3,
  "domains": [
    "127.0.0.1",
    "niuniuapi.qihongmy.cn",
    "upstream-sim.kaivo-sim.svc.cluster.local"
  ],
  "secrets": {
    "merchant_key": "shared"
  },
  "secret_fields": {
    "query": [
      "key"
    ]
  },
  "public_keys": [],
  "config": {
    "gateway": {
      "type": "string",
      "required": true
    },
    "pid": {
      "type": "string",
      "required": true
    },
    "product_name": {
      "type": "string",
      "required": true
    },
    "unpaid_timeout_seconds": {
      "type": "string",
      "required": true
    }
  },
  "capabilities": [
    "create_payment",
    "query_payment",
    "route_callback",
    "verify_callback"
  ],
  "callback": {
    "content_types": [
      "application/x-www-form-urlencoded"
    ],
    "ack_status": 200,
    "ack_body": "success",
    "ack_content_type": "text/plain",
    "methods": [
      "GET"
    ],
    "allow_query": true
  }
}
